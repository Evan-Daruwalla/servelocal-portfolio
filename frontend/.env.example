# Copy to .env.local and adjust. NEXT_PUBLIC_* vars are exposed to the browser.
# Base URL of the ServeLocal FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public site URL — used for metadataBase, OG tags, sitemap.xml, robots.txt.
# Must include the scheme; a bare hostname throws at startup. Build-time: rebuild, don't restart.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cloudflare Turnstile widget site key (public). Blank = no widget rendered / no
# token sent (dev/CI default). Pair with the backend's TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Support/contact address shown on the legal pages. Must match the backend's
# SUPPORT_EMAIL. Blank renders a visible placeholder rather than a fake address.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Gates the Pro upgrade surface (ADR 0002, "coming soon" at launch — Evan
# 2026-08-31). Unset/false shows "launching soon" and hides checkout — the safe
# default when the backend has no Stripe keys. Set true only when live billing
# is enabled (ADR 0002 §Follow-ups #3). Build-time: rebuild, don't restart.
NEXT_PUBLIC_BILLING_LIVE=false
